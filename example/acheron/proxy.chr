[[proxy]]
listener = "127.0.0.1:8080"
tls_certificate = "path/to/cert1"
tls_certificate_key = "path/to/key1"

[[host="server1"]]
proxy_addr = "/tmp/proxy1.sock"
proxy_tls = true
proxy_headers = [
    ["Header1", "Value1"]
]
proxy_uds = true

[[[route="/route1"]]]
proxy_tls = true

[[[route="/route2"]]]
proxy_tls = true

[[proxy]]
listener = "127.0.0.1:9090"
tls_certificate = "path/to/cert2"
tls_certificate_key = "path/to/key2"

[[host="server2"]]
proxy_addr = "192.168.1.2"
proxy_tls = false
proxy_headers = [
    ["Header2", "Value2"]
]

[[[route="/home"]]]
proxy_tls = false

[[[route="/status"]]]
proxy_tls = false
